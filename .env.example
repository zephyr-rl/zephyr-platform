# Copy to .env and fill in. Never commit .env.

# Database password for the bundled PostgreSQL (docker compose).
POSTGRES_PASSWORD=change-me

# Encrypts marketplace credentials and other secrets at rest.
# Generate with:  docker compose run --rm api python -m app.cli generate-key
# Keep a copy somewhere safe: without it, stored credentials cannot be read.
ZP_SECRET_KEYS=

# Where the panel is served. A domain gets a real certificate automatically:
#   ZP_SITE_ADDRESS=zephyrstore.site   ZP_TLS_MODE=auto
# Without a domain, use the server IP with a self-signed certificate:
#   ZP_SITE_ADDRESS=https://203.0.113.10   ZP_TLS_MODE=internal
ZP_SITE_ADDRESS=
ZP_TLS_MODE=auto
